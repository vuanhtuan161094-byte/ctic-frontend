# =========================
# DEPLOYMENT / NETWORK
# =========================
# URL backend mà trình duyệt gọi cho API nội bộ.
# DEV tách cổng: http://localhost:3000
# LAN:           http://192.168.1.50:3000
# DOMAIN:        https://api.example.com
# Nếu bỏ trống: Vite dev/preview tự dùng host hiện tại :3000; bản deploy khác sẽ ưu tiên same-origin.
VITE_API_BASE_URL=http://localhost:3000

# URL backend công khai dùng cho link/QR chứng chỉ trên giao diện.
# Có thể giống VITE_API_BASE_URL. Chỉ cần tách khi API nội bộ và URL công khai khác nhau.
VITE_PUBLIC_API_BASE_URL=http://localhost:3000

# =========================
# BRANDING
# =========================
# Branding giao diện - để mặc định trung tính hoặc thay bằng thương hiệu của tổ chức triển khai.
VITE_BRAND_SHORT_NAME=CB
VITE_BRAND_ORGANIZATION_NAME=TỔ CHỨC CHỨNG NHẬN
VITE_PLATFORM_NAME=Nền tảng quản lý chứng nhận
VITE_PLATFORM_NAME_EN=Certification Management Platform
VITE_BROWSER_TITLE=CB Certification Management Platform
VITE_BROWSER_DESCRIPTION=Nền tảng quản lý chứng nhận
VITE_DOCUMENT_CODE_PREFIX=CB
VITE_SUPPORT_CONTACT_LABEL=quản trị viên hệ thống
VITE_BRAND_PRIMARY_COLOR=#0b4ba2
VITE_BRAND_DARK_COLOR=#082f6b
VITE_BRAND_ACCENT_COLOR=#1a6ac7

# Production/LAN: không copy nguyên giá trị localhost ở trên nếu người dùng truy cập từ máy khác.
# Có thể bỏ VITE_API_BASE_URL/VITE_PUBLIC_API_BASE_URL để frontend Vite dev tự suy luận host hiện tại :3000,
# hoặc đặt rõ URL backend/domain thật khi build production.
