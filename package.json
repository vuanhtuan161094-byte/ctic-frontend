{
  "name": "ctic-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Certification Management Platform frontend",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.ctic.config.ts --port 5173",
    "build": "vite build --config vite.ctic.config.ts",
    "start": "vite preview --config vite.ctic.config.ts --port 5173",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser:setup": "npm --prefix e2e ci && npm --prefix e2e run install:chromium",
    "test:browser": "npm --prefix e2e test",
    "test:browser:configuration": "npm --prefix e2e run test:configuration",
    "test:browser:headed": "npm --prefix e2e run test:headed",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.all.json --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "test:storybook": "npm --prefix e2e run test:storybook --"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.3",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "type": "module"
}
